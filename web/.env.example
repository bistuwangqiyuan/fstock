# Optional production site URL for sitemap/OG
NEXT_PUBLIC_SITE_URL=https://fstock.vercel.app

# Required for /api/cron/refresh (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=replace-with-long-random-string

# Optional waitlist email delivery
RESEND_API_KEY=
RESEND_FROM=F Stock <onboarding@resend.dev>

# Optional AdSense publisher id (ads stay hidden until set)
NEXT_PUBLIC_ADSENSE_CLIENT=
